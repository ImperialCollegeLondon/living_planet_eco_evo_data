{"version":3,"kind":"Notebook","sha256":"416a30765b943de5a9180eea4e04d151ea63d47a7ab6aa6eb38d6c3b9c3e938f","slug":"why-r-for-gis","location":"/gis_practical/why_r_for_gis.md","dependencies":[],"frontmatter":{"title":"Why use R for GIS","authors":[{"nameParsed":{"literal":"David Orme","given":"David","family":"Orme"},"name":"David Orme","id":"contributors-why_r_for_gis-generated-uid-0"}],"kernelspec":{"name":"uvr-ecoevodata","display_name":"R (ecoevodata)","language":"R"},"jupytext":{"formats":"md:myst","text_representation":{"extension":".md","format_name":"myst","format_version":"0.13","jupytext_version":"1.18.1"}},"content_includes_title":false,"github":"https://github.com/imperialcollegelondon/living_planet_eco_evo_data","numbering":{"title":{"offset":1}},"source_url":"https://github.com/imperialcollegelondon/living_planet_eco_evo_data/blob/main/practicals/gis_practical/why_r_for_gis.md","edit_url":"https://github.com/imperialcollegelondon/living_planet_eco_evo_data/edit/main/practicals/gis_practical/why_r_for_gis.md","exports":[{"format":"md","filename":"why_r_for_gis.md","url":"/build/why_r_for_gis-cb983ce4ff919fece7964f5f890d69cc.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"There are a number of really good reasons for using R for the GIS in this module:","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"OpZ9SNInLR"}],"key":"FQZ4P2Z1yZ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":21,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It is an open-source, cross-platform and free program.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"OaUwscIgw