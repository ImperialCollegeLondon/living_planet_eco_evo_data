{"version":3,"kind":"Notebook","sha256":"416a30765b943de5a9180eea4e04d151ea63d47a7ab6aa6eb38d6c3b9c3e938f","slug":"why-r-for-gis","location":"/gis_practical/why_r_for_gis.md","dependencies":[],"frontmatter":{"title":"Why use R for GIS","authors":[{"nameParsed":{"literal":"David Orme","given":"David","family":"Orme"},"name":"David Orme","id":"contributors-why_r_for_gis-generated-uid-0"}],"kernelspec":{"name":"uvr-ecoevodata","display_name":"R (ecoevodata)","language":"R"},"jupytext":{"formats":"md:myst","text_representation":{"extension":".md","format_name":"myst","format_version":"0.13","jupytext_version":"1.18.1"}},"content_includes_title":false,"github":"https://github.com/imperialcollegelondon/living_planet_eco_evo_data","numbering":{"title":{"offset":1}},"source_url":"https://github.com/imperialcollegelondon/living_planet_eco_evo_data/blob/main/practicals/gis_practical/why_r_for_gis.md","edit_url":"https://github.com/imperialcollegelondon/living_planet_eco_evo_data/edit/main/practicals/gis_practical/why_r_for_gis.md","exports":[{"format":"md","filename":"why_r_for_gis.md","url":"https://imperialcollegelondon.github.io/living_planet_eco_evo_data/build/why_r_for_gis-f2ff393194c9741781e1c48efa131797.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"There are a number of really good reasons for using R for the GIS in this module:","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"FC1lgztT8Y"}],"key":"p2xJ5JtT2Q"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":21,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It is an open-source, cross-platform and free program.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"qTgoAOmg6N"}],"key":"invKOkYmMG"}],"key":"Fnm4Rmn2go"},{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It provides a powerful set of GIS data tools and packages extend this GIS\nfunctionality into a well estabished ecosystem of R packages for ecological and\nevolutionary analysis, including species distribution modelling, population genetics\nand many other areas.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"yDtyG2YonY"}],"key":"p29PWewilA"}],"key":"umRhtm7w9m"},{"type":"listItem","spread":true,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Writing spatial analyses as R scripts provides a clear reproducible research record.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"fhkgYb8CsL"}],"key":"xLLIESmgQD"}],"key":"FE1lSSLpax"},{"type":"listItem","spread":true,"position":{"start":{"line":27,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It integrates easily with the use of R in the other practicals.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"lyJMJPhwgp"}],"key":"BP4oJNuzyb"}],"key":"rQooDW9vj6"}],"key":"kffPjzNdu9"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"There are disadvantages to using R as a GIS platform:","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"ZQNAB22mwS"}],"key":"iCgPEvs6zL"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":31,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":33,"c