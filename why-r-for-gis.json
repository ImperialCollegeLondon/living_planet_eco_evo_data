{"version":3,"kind":"Notebook","sha256":"416a30765b943de5a9180eea4e04d151ea63d47a7ab6aa6eb38d6c3b9c3e938f","slug":"why-r-for-gis","location":"/gis_practical/why_r_for_gis.md","dependencies":[],"frontmatter":{"title":"Why use R for GIS","authors":[{"nameParsed":{"literal":"David Orme","given":"David","family":"Orme"},"name":"David Orme","id":"contributors-why_r_for_gis-generated-uid-0"}],"kernelspec":{"name":"uvr-ecoevodata","display_name":"R (ecoevodata)","language":"R"},"jupytext":{"formats":"md:myst","text_representation":{"extension":".md","format_name":"myst","format_version":"0.13","jupytext_version":"1.18.1"}},"content_includes_title":false,"github":"https://github.com/imperialcollegelondon/living_planet_eco_evo_data","numbering":{"title":{"offset":1}},"source_url":"https://github.com/imperialcollegelondon/living_planet_eco_evo_data/blob/main/practicals/gis_practical/why_r_for_gis.md","edit_url":"https://github.com/imperialcollegelondon/living_planet_eco_evo_data/edit/main/practicals/gis_practical/why_r_for_gis.md","exports":[{"format":"md","filename":"why_r_for_gis.md","url":"https://imperialcollegelondon.github.io/living_planet_eco_evo_data/build/why_r_for_gis-cb983ce4ff919fece7964f5f890d69cc.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"There are a number of really good reasons for using R for the GIS in this module:","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Uc3Tf5i6iZ"}],"key":"CPvcxzi8B1"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":21,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It is an open-source, cross-platform and free program.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"Okfb4zozyQ"}],"key":"dD4JolkDA0"}],"key":"PQZcXMJEiP"},{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It provides a powerful set of GIS data tools and packages extend this GIS\nfunctionality into a well estabished ecosystem of R packages for ecological and\nevolutionary analysis, including species distribution modelling, population genetics\nand many other areas.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"H1aoYAOaez"}],"key":"lgNgg1yYQ3"}],"key":"sjf194eZYz"},{"type":"listItem","spread":true,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Writing spatial analyses as R scripts provides a clear reproducible research record.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"nj0oOlguw8"}],"key":"mjh4hVPchD"}],"key":"iaPJrp5CYK"},{"type":"listItem","spread":true,"position":{"start":{"line":27,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It integrates easily with the use of R in the other practicals.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"g2NdLs7IUs"}],"key":"CCySvwwBn7"}],"key":"nMT3AacQWh"}],"key":"gEdhiwaLFx"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"There are disadvantages to using R as a GIS platform:","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"reAHzRrCrJ"}],"key":"nCjbGbDPXl"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":31,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Principally, although it can create very high quality spatial graphics, it is not a\nGIS data visualiser and explorer program. It is not as easy to zoom and pan around\nspatial datasets in R or to alter the way in which a set of layers overlay each other.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"zE1rM4uDgU"}],"key":"Ein2TwvH4p"}],"key":"p7sbpCM2Uv"},{"type":"listItem","spread":true,"position":{"start":{"line":34,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It can also be difficult to find the exact set of commands you need to get the result\nyou are after (although this can also be true of other systems)!","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"qBRH1kveyq"}],"key":"BENPOtHyDc"}],"key":"fdikVWx2u9"}],"key":"jYdtPEhWq4"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"If you end up using GIS more widely in your research project, you may find it useful to\nlook at other GIS programs for exploring and visualising data:","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"RffaJ80z5G"}],"key":"YL3w0C41De"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":40,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The most well known is probably the ESRI ArcGIS package: Imperial College London does\nhave a ","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"MXq2ixvZsl"},{"type":"link","url":"https://www.imperial.ac.uk/admin-services/ict/self-service/computers-printing/devices-and-software/get-software/get-software-for-stude