xt","value":"Principally, although it can create very high quality spatial graphics, it is not a\nGIS data visualiser and explorer program. It is not as easy to zoom and pan around\nspatial datasets in R or to alter the way in which a set of layers overlay each other.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"yRSi3RYdX7"}],"key":"QdYaelzHF2"}],"key":"FDbhrn77It"},{"type":"listItem","spread":true,"position":{"start":{"line":34,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It can also be difficult to find the exact set of commands you need to get the result\nyou are after (although this can also be true of other systems)!","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"MBjtnbtl1w"}],"key":"Y6WgxCMC58"}],"key":"ZLM00h76dg"}],"key":"KBfjpt71eD"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"If you end up using GIS more widely in your research project, you may find it useful to\nlook at other GIS programs for exploring and visualising data:","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"yzGmfKQR7I"}],"key":"uKaDCFp8wt"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":40,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The most well known is probably the ESRI ArcGIS package: Imperial College London does\nhave a ","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"zSqUXkkaJ7"},{"type":"link","url":"https://www.imperial.ac.uk/admin-services/ict/self-service/computers-printing/devices-and-software/get-software/get-software-for-students/arcgis/","position":{"start":{"line":40,"column":1},"end":{"li